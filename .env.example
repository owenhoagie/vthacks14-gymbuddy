# Server configuration. Copy to .env; never commit real credentials.
DATA_MODE=demo
# Use collector_fallback while the free Databricks warehouse is unavailable.
LIVE_DATA_SOURCE=databricks
LIVE_FALLBACK_URL=https://raw.githubusercontent.com/owenhoagie/vthacks14-gymbuddy/live-data/snapshot.json
GEMINI_API_KEY=
GEMINI_MODEL=
# Per model call; at most two calls per successful recommendation, no retries.
GEMINI_TIMEOUT_SECONDS=12
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_SQL_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=gymbuddy
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
COLLECTOR_INTERVAL_SECONDS=300
