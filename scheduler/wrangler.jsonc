{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gymbuddy-collector-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
